    {
      "name": "Study quizzes — POST /v1/ai/quiz",
      "item": [
        {
          "name": "05 — Generate 3 foundation questions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('sessionCookie')) throw new Error('Set sessionCookie to your current FOLIO_SESSION cookie value (value only).');",
                  "if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(pm.environment.get('documentId') || '')) throw new Error('Set documentId to a READY document owned by this account.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.info('Folio AI', pm.info.requestName, 'status', pm.response.code, 'elapsedMs', pm.response.responseTime);",
                  "pm.test('Response meets configured total-time budget', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseMs') || 50000));",
                  "});",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const request = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "  pm.test('Quiz includes source-backed four-option questions', () => {",
                  "    pm.expect(data.model).to.be.a('string').and.not.empty;",
                  "    pm.expect(data.questions).to.be.an('array').and.not.empty;",
                  "    pm.expect(data.questions.length).to.be.at.most(request.count);",
                  "    pm.expect(data.requestedCount).to.equal(request.count);",
                  "    pm.expect(data.difficulty).to.equal(request.difficulty);",
                  "    data.questions.forEach(q => {",
                  "      pm.expect(q.prompt).to.be.a('string').and.not.empty;",
                  "      pm.expect(q.options).to.be.an('array').with.lengthOf(4);",
                  "      q.options.forEach(option => pm.expect(option).to.be.a('string').and.not.empty);",
                  "      pm.expect(Number.isInteger(q.correctIndex)).to.equal(true);",
                  "      pm.expect(q.correctIndex).to.be.within(0, 3);",
                  "      pm.expect(q.explanation).to.be.a('string').and.not.empty;",
                  "      pm.expect(q.sourceDocumentId).to.equal(request.documentId);",
                  "      pm.expect(q.sourceExcerpt).to.be.a('string').and.not.empty;",
                  "    });",
                  "  });",
                  "  console.info('Quiz model', data.model, 'questionCount', data.questions.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
