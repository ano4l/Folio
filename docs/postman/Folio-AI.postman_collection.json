{
  "info": {
    "_postman_id": "785621c7-c7f1-4f44-a019-b13d57587fbc",
    "name": "Folio — AI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AI endpoints only. Import the companion environment, supply a valid FOLIO_SESSION cookie and a READY document ID. Requests send real AI work and may record usage. No authentication, document-management or admin endpoints are included. See README.md for timing and setup."
  },
  "item": [
    {
      "name": "Document assistant — POST /v1/ai/ask",
      "item": [
        {
          "name": "01 — Greeting (auth/connectivity baseline)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('sessionCookie')) throw new Error('Set sessionCookie to your current FOLIO_SESSION cookie value (value only).');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.info('Folio AI', pm.info.requestName, 'status', pm.response.code, 'elapsedMs', pm.response.responseTime);",
                  "pm.test('Response meets configured total-time budget', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseMs') || 50000));",
                  "});",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('NDJSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/x-ndjson'));",
                  "  const events = pm.response.text().trim().split(/\\r?\\n/).filter(Boolean).map(line => JSON.parse(line));",
                  "  let answer = '';",
                  "  events.forEach(e => { if (e.type === 'delta') answer += e.text; if (e.type === 'replace') answer = e.text; });",
                  "  const done = events.find(e => e.type === 'done');",
                  "  pm.test('Nonempty answer and final done event', () => {",
                  "    pm.expect(answer.trim()).not.to.equal('');",
                  "    pm.expect(events[events.length - 1].type).to.equal('done');",
                  "    pm.expect(done.citations).to.be.an('array');",
                  "  });",
                  "  ",
                  "  console.info('Completion model', done && done.model, 'citationCount', done && done.citations.length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/x-ndjson"
              },
              {
                "key": "X-Requested-With",
                "value": "FolioWeb"
              },
              {
                "key": "Cookie",
                "value": "FOLIO_SESSION={{sessionCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Hello\",\n  \"history\": [],\n  \"documentId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/ai/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ai",
                "ask"
              ]
            },
            "description": "Authenticated baseline; greeting bypasses the AI provider. A quick result here does not prove provider availability."
          },
          "response": []
        },
        {
          "name": "02 — Ask one document",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('sessionCookie')) throw new Error('Set sessionCookie to your current FOLIO_SESSION cookie value (value only).');",
                  "if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(pm.environment.get('documentId') || '')) throw new Error('Set documentId to a READY document owned by this account.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.info('Folio AI', pm.info.requestName, 'status', pm.response.code, 'elapsedMs', pm.response.responseTime);",
                  "pm.test('Response meets configured total-time budget', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseMs') || 50000));",
                  "});",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('NDJSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/x-ndjson'));",
                  "  const events = pm.response.text().trim().split(/\\r?\\n/).filter(Boolean).map(line => JSON.parse(line));",
                  "  let answer = '';",
                  "  events.forEach(e => { if (e.type === 'delta') answer += e.text; if (e.type === 'replace') answer = e.text; });",
                  "  const done = events.find(e => e.type === 'done');",
                  "  pm.test('Nonempty answer and final done event', () => {",
                  "    pm.expect(answer.trim()).not.to.equal('');",
                  "    pm.expect(events[events.length - 1].type).to.equal('done');",
                  "    pm.expect(done.citations).to.be.an('array');",
                  "  });",
                  "  pm.test('Provider returned a grounded answer, not an abstention', () => {",
                  "    pm.expect(done.model).to.be.a('string').and.not.empty;",
                  "    pm.expect(done.citations.length).to.be.above(0);",
                  "    const numbers = [...answer.matchAll(/\\[SOURCE:(\\d+)\\]/g)].map(m => Number(m[1]));",
                  "    pm.expect(numbers.length).to.be.above(0);",
                  "    numbers.forEach(n => pm.expect(done.citations.some(c => c.number === n)).to.equal(true));",
                  "    done.citations.forEach(c => { pm.expect(c.documentId).to.be.a('string').and.not.empty; pm.expect(c.excerpt).to.be.a('string').and.not.empty; });",
                  "  });",
                  "  console.info('Completion model', done && done.model, 'citationCount', done && done.citations.length);",
                  "}"
                ]
              }
            }
          ],
