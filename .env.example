# Folio Vercel deployment environment template
# Add these in Vercel Project Settings -> Environment Variables.
# Use Production, Preview, and Development scopes as appropriate.

# Public runtime configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=https://your-folio-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase access. Never expose or prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Server-only email verification security and Resend delivery
AUTH_OTP_PEPPER=replace-with-at-least-32-random-characters
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Folio <security@your-verified-domain.example>

# Server-only OpenRouter document summarisation and grounded chat
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ZDR=false

# Keep false in production unless demo seed data is explicitly required.
