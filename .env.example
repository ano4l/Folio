NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_OTP_PEPPER=replace-with-at-least-32-random-characters
# Server-only admin allowlist. Accounts must still complete normal Folio sign-in.
FOLIO_ADMIN_EMAILS=anotida@virtukey.co.za
RESEND_API_KEY=
EMAIL_FROM=Folio <security@your-verified-domain.example>
# Fast free AI provider. When GROQ_API_KEY is set, Groq serves every AI
# feature first. Its rate limits are per model, so a busy or rate-limited
# request moves straight to the next model in GROQ_FALLBACK_MODELS.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.1-8b-instant
# Used alone when GROQ_API_KEY is empty, and after Groq when both are set.
# Order: the requested model, OPENROUTER_MODEL (if not the free router),
# OPENROUTER_FAST_MODEL, then openrouter/free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FAST_MODEL=cohere/north-mini-code:free
OPENROUTER_QUIZ_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_QUIZ_FALLBACK_MODEL=cohere/north-mini-code:free
OPENROUTER_ZDR=false
